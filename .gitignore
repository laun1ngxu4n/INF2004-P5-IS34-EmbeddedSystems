# macOS
.DS_Store

# Logs: the panel's (logs/panel/) and the robot's (logs/robot/), saved by
# tools/panel/is34_panel.py.  Kept on the laptop only; copy the ones that
# matter into testing/<subsystem>/logs/ to keep them.
logs/*
!logs/README.md

# Python caches
__pycache__/

# Test images with MQTT carry the WiFi password (config/wifi_secrets.h):
